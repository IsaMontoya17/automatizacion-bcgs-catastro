# ============================================================
# Plantilla de variables de entorno
# Copia este archivo como ".env" y completa los valores.
# NUNCA subas el archivo ".env" real al repositorio.
# ============================================================

# --- Automatización BCGS ---
# URL de inicio de sesión de la plataforma BCGS
URL_BCGS=https://catastroantioquia-mas.com/bcgs/login.html#/
# Credenciales institucionales para ingresar a BCGS
USUARIO_SISTEMA=tu_usuario_bcgs
CLAVE_SISTEMA=tu_clave_bcgs
# Carpeta (relativa a la raíz del proyecto) donde se guardan las descargas y reportes
CARPETA_PRINCIPAL=envio_correos_mensuales
# Tiempo máximo de espera de Puppeteer, en segundos
TIMEOUT_ESPERA=180

# --- Correo (Nodemailer) ---
# Proveedor: gmail (desarrollo) | Outlook365 (cuenta institucional con SMTP habilitado)
EMAIL_SERVICIO=gmail
# Cuenta remitente
EMAIL_USUARIO=correo@ejemplo.com
# Clave de aplicación (no la contraseña normal de la cuenta)
EMAIL_CLAVE=tu_clave_de_aplicacion
# Nombre que verán los municipios como remitente
EMAIL_REMITENTE_NOMBRE=Gerencia de Catastro - Gobernación de Antioquia
# URL base del servidor
BASE_URL=http://localhost:3000

# --- Base de datos (MySQL) ---
# Formato: mysql://USUARIO:CLAVE@HOST:PUERTO/NOMBRE_BD
DATABASE_URL="mysql://usuario:clave@localhost:3306/catastro_resoluciones"

# --- Autenticación (JWT) ---
# Cadena larga y aleatoria. Genérala con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_cadena_aleatoria_larga
# Duración de la sesión (ej.: 8h, 30m)
JWT_EXPIRES_IN=8h
